<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 开屏专用主题：桌面图标保持「原图满幅版」（ic_launcher），
         系统开屏单独使用透明四角图标（ic_splash）+ 深色背景，
         避免满幅版的黑角在开屏上裸露。 -->
    <style name="Theme.IWebPlayerSplash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowSplashScreenBackground">#111827</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
    </style>
</resources>
